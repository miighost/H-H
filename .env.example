# Firebase Configuration (Vite Client-side)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
WAAFI_MERCHANT_UID=
WAAFI_STORE_ID=
WAAFI_HPP_KEY=
WAAFI_API_URL=https://api.waafipay.com/asm
PUBLIC_BASE_URL=https://hornandharvest.com
# Base64-encoded Firebase service-account JSON. Server-side only; never prefix with VITE_.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Preferred local alternative: absolute path to a private service-account JSON file outside this repository.
# Set one Firebase Admin credential option, not both.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=hornandharvest
CEO_AUTHORISED_EMAIL=info@hornandharvest.com

# Production API
API_BASE_URL=
API_ALLOWED_ORIGINS=https://hornandharvest.com
API_RATE_LIMIT_PER_MINUTE=120
PROOF_OF_DELIVERY_STORAGE_BUCKET=
LOCATION_RETENTION_DAYS=90

# Keep false until server-side payment verification and order persistence are commissioned.
VITE_PAYMENTS_ENABLED=false

# Do not enable until gateway callbacks are verified against persisted orders.
PAYMENTS_COMMISSIONED=false

# Own-server data: Node 24 LTS, one managed Node process, persistent volume required.
DATA_BACKEND=sqlite
DATA_DIRECTORY=/srv/horn-harvest/data
# Leave empty for direct Node access. Behind Nginx on loopback use loopback.
TRUST_PROXY=loopback
# Optional self-hosted OSRM; without road data, ETA is explicitly a distance estimate.
OSRM_URL=
ESTIMATED_SPEED_KMH=25
WAAFI_WEBHOOK_SECRET=
